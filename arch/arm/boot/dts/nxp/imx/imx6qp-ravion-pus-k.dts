/dts-v1/;
#include "imx6qp.dtsi"

#define SPI_CS_GPIO
#include "imx6qdl-ravion-v2.dtsi"

/ {
	model = "ravion:pus";
	compatible = "ravion,imx6qp", "fsl,imx6qp";

	/*
	 * Device specific regulators
	 */
	reg_p5vg: regulator-p5v { /* DA2 */
			compatible = "regulator-fixed";
			regulator-name = "P5V";
			regulator-min-microvolt = <5000000>;
			regulator-max-microvolt = <5000000>;
			regulator-boot-on;
			regulator-always-on;
	};

	reg_p3v3: regulator-p3v3 { /* DA29 */
			compatible = "regulator-fixed";
			regulator-name = "P3V3";
			regulator-min-microvolt = <3300000>;
			regulator-max-microvolt = <3300000>;
			vin-supply = <&reg_p5vg>;
			regulator-boot-on;
			regulator-always-on;
	};

	reg_wl1837_p1v8: regulator-wl1837-p1v8 { /* DA5 */
			compatible = "regulator-fixed";
			regulator-name = "wl1837-reg";
			regulator-min-microvolt = <1800000>;
			regulator-max-microvolt = <1800000>;
			vin-supply = <&reg_p3v3>;
#if 0
			/* Fixme. No such cirquit? */
			gpio = <&gpio3 19 GPIO_ACTIVE_HIGH>;	/* soDimm 25 */
			startup-delay-us = <70000>;
			enable-active-high;
#endif
	};

	reg_tlv_p1v8: regulator-tlv { /* DA4 */
			compatible = "regulator-fixed";
			regulator-name = "TLV-P1V8";
			regulator-min-microvolt = <1800000>;
			regulator-max-microvolt = <1800000>;
			vin-supply = <&reg_p3v3>;
			regulator-boot-on;
			regulator-always-on;
	};

	reg_ksz_p1v2: regulator-ksz-p1v2 { /* DA12 */
			compatible = "regulator-fixed";
			regulator-name = "ksz-p1v2";
			regulator-min-microvolt = <1200000>;
			regulator-max-microvolt = <1200000>;
			vin-supply = <&reg_p3v3>;
			regulator-boot-on;
			regulator-always-on;
	};

	/* from <imx6qp-ravion-mtu.dts> */
	panel {
		power-supply = <&reg_p3v3>;
		backlight = <&lcd_backlight>;
		//compatible = "mitsubishi,aa050mh01-da1";
/****** Alternative record (without panel-simple patches ******
		compatible = "panel-dpi";
		width-mm = <109>;
		height-mm = <65>;

		panel-timing {
			clock-frequency = <30400000>;
			hactive = <800>;
			vactive = <480>;
			hfront-porch = <60>;
			hsync-len = <40>;
			hback-porch = <60>;
			vfront-porch = <15>;
			vsync-len = <15>;
			vback-porch = <15>;
			hsync-active = <0>;
			vsync-active = <0>;
			de-active = <1>;
			pixelclk-active = <1>;
		};
****** Alternative record (without panel-simple patches ******/

		port {
			lcd_panel_in: endpoint {
				remote-endpoint = <&tft_bus_out>;
			};
		};
		
		lcd_backlight: lcd_backlight {
			compatible = "pwm-backlight";
			pwms = <&pwm3 0 2000 0>; /* FixMe: frequency !!! */
			brightness-levels = <0 25 51 76 102 127 153 178 204 229 255>;
			default-brightness-level = <9>;
			status = "okay";
		};
	};

	sound-tlv320 {
		compatible = "fsl,imx-audio-tlv320aic32x4";
		model = "ravion-tlv320aic32x6";
		ssi-controller = <&ssi2>;
		audio-codec = <&tlv320aic3206>;
		audio-routing =
			"IN1_L", "Line In Jack",
			"IN1_R", "Line In Jack",
			"IN2_L", "Line In Jack",
			"IN2_R", "Line In Jack",
			"Headphone Jack", "HPL",
			"Headphone Jack", "HPR",
			"Line Out Jack", "LOL",
			"Line Out Jack", "LOR";
		mux-int-port = <2>;
		mux-ext-port = <5>;
	};

	gpio-keys {
		compatible = "gpio-keys";

		KEY_ESC {
			label = "KEY_ESC";
			gpios = <&gpio6 0 GPIO_ACTIVE_LOW>;		/* soDimm 168 */
			linux,code = <KEY_ESC>;
			debounce-interval = <100>;
			wakeup-source;
		};

		KEY_ENTER {
			label = "KEY_ENTER";
			gpios = <&gpio5 21 GPIO_ACTIVE_LOW>;	/* soDimm 170 */
			linux,code = <KEY_ENTER>;
			debounce-interval = <100>;
			wakeup-source;
		};
		
		KEY_1 {
			label = "KEY_1";
			gpios = <&gpio4 9 GPIO_ACTIVE_LOW>;		/* soDimm 152 */
			linux,code = <KEY_1>;
			debounce-interval = <100>;
			wakeup-source;
		};

		KEY_2 {
			label = "KEY_2";
			gpios = <&gpio4 10 GPIO_ACTIVE_LOW>;	/* soDimm 154 */
			linux,code = <KEY_2>;
			debounce-interval = <100>;
			wakeup-source;
		};

		KEY_3 {
			label = "KEY_3";
			gpios = <&gpio4 14 GPIO_ACTIVE_LOW>;	/* soDimm 156 */
			linux,code = <KEY_3>;
			debounce-interval = <100>;
			wakeup-source;
		};

		KEY_4 {
			label = "KEY_4";
			gpios = <&gpio4 15 GPIO_ACTIVE_LOW>;	/* soDimm 158 */
			linux,code = <KEY_4>;
			debounce-interval = <100>;
			wakeup-source;
		};

		KEY_UP {
			label = "KEY_UP";
			gpios = <&gpio6 1 GPIO_ACTIVE_LOW>;		/* soDimm 160 */
			linux,code = <KEY_UP>;
			debounce-interval = <100>;
			wakeup-source;
		};

		KEY_DOWN {
			label = "KEY_DOWN";
			gpios = <&gpio6 5 GPIO_ACTIVE_LOW>;		/* soDimm 162 */
			linux,code = <KEY_DOWN>;
			debounce-interval = <100>;
			wakeup-source;
		};

		KEY_LEFT {
			label = "KEY_LEFT";
			gpios = <&gpio5 30 GPIO_ACTIVE_LOW>;	/* soDimm 164 */
			linux,code = <KEY_LEFT>;
			debounce-interval = <100>;
			wakeup-source;
		};

		KEY_RIGHT {
			label = "KEY_RIGHT";
			gpios = <&gpio6 2 GPIO_ACTIVE_LOW>;		/* soDimm 166 */
			linux,code = <KEY_RIGHT>;
			debounce-interval = <100>;
			wakeup-source;
		};
		
		PTT1 {
			label = "TNG1";
			gpios = <&gpio3 19 GPIO_ACTIVE_LOW>;	/* soDimm25 */
			linux,code = <KEY_F2>;
			debounce-interval = <100>;
			wakeup-source;
		};

		PTT2 {
			label = "TNG2";
			gpios = <&gpio3 25 GPIO_ACTIVE_LOW>;	/* soDimm29 */
			linux,code = <KEY_F10>;
			debounce-interval = <100>;
			wakeup-source;
		};

		CALL1 {
			label = "CALL1";
			gpios = <&gpio3 24 GPIO_ACTIVE_LOW>;	/* soDimm23 */
			linux,code = <KEY_F13>;
			debounce-interval = <100>;
			wakeup-source;
		};

		CALL2 {
			label = "CALL2";
			gpios = <&gpio3 20 GPIO_ACTIVE_LOW>;	/* soDimm27 */
			linux,code = <KEY_F14>;
			debounce-interval = <100>;
			wakeup-source;
		};
		
	};

	gpio-leds {
		compatible = "gpio-leds";

		keys_backlight 	{
			label = "backlight::green";
			gpios = <&gpio4 8 GPIO_ACTIVE_HIGH>;		/* soDimm 150 */
			default-state = "off";
		};

		ST_Red 	{
			label = "status::red";
			gpios = <&gpio1 4 GPIO_ACTIVE_HIGH>;		/* soDimm 188 */
			default-state = "off";
		};

		ST_Green 	{
			label = "status::green";
			gpios = <&gpio4 7 GPIO_ACTIVE_HIGH>;		/* soDimm 190 */
			default-state = "off";
		};

		ST_Blue 	{
			label = "status::blue";
			gpios = <&gpio5 20 GPIO_ACTIVE_HIGH>;		/* soDimm 192 */
			linux,default-trigger = "heartbeat";
			default-state = "on";
		};
	};
};

/* VGA */
&tft_display_bus {
      status = "okay";
};

&tft_bus_out {
       remote-endpoint = <&lcd_panel_in>;
};

/*
 * Serial ports
 */
&uart1 {	status = "okay";	};
&uart2 {
	uart-has-rtscts;
	status = "okay";

	bluetooth {
		enable-gpios = <&gpio5 18 GPIO_ACTIVE_HIGH>; /* soDimm 172 */
		compatible = "ti,wl1837-st";
		clocks = <&clk_32k_bt 0>;
		clock-names = "ext_clock";
		max-speed = <3686400>;
		current-speed = <115200>;
		status = "okay";

		clk_32k_bt: bt_clk {
			compatible = "fixed-clock";
			#clock-cells = <0>;
			clock-frequency = <32768>;
			clock-accuracy = <100>;
		};
	};
};
&uart3 {	status = "okay";	};	

/*
 * I2C Busses
 */
&i2c2 {	/* Compatible I2C: soDimm 194, 196 */
	status = "okay";

	/* ext codec */
	#address-cells = <1>;
	#size-cells = <0>;
	tlv320aic3206: codec@18 {
		compatible = "ti,tlv320aic32x6";
		reg = <0x18>;
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_ext_aud5>, <&pinctrl_clkext>;
		iov-supply = <&reg_p3v3>;
		av-supply = <&reg_tlv_p1v8>;
		dv-supply = <&reg_tlv_p1v8>;
		clocks = <&clks IMX6QDL_CLK_CKO2>; /* soDimm 137 */
		clock-names = "mclk";
	};
};

&ecspi1 {
	status = "okay";

	spi_switch: ksz8795clx@0 {
		compatible = "microchip,ksz8795";
		reg = <0>;
		spi-max-frequency = <200000>;
		spi_cpha;
		status = "okay"; /* Attention! Tail tagging only for port 5 */
		/* Fixme! Other projects with this switch not handle IRQs */
		interrupt-parent = <&gpio3>;
		interrupts = <23 IRQ_TYPE_LEVEL_HIGH>;		/* soDimm 31 */

		/*ethernet-*/ports {
			#address-cells = <1>;
			#size-cells = <0>;
			port@0 {
				reg = <0>;
				label = "lan1";
			};
			port@1 {
				reg = <1>;
				label = "lan2";
			};
			port@2 {
				reg = <2>;
				label = "lan3";
			};
			port@3 {
				reg = <3>;
				label = "lan4";
			};
			port@4 {
				reg = <4>;
				label = "cpu";
				phy-mode = "rgmii-id";
				rx-internal-delay-ps = <0>;
				tx-internal-delay-ps = <0>;
				ethernet = <&lan7431>;

				fixed-link {
					speed = <1000>;
					full-duplex;
				};
			};
		};
	};
};

&pcie {
	#address-cells = <0x03>;
	#size-cells = <0x02>;
	status = "okay";
	/*
		reg = <0xBBSSFF00 0 0 0 0>;
		BB - BUS number (hex)
		SS - Device/Slot number (5 bit)
		FF - Function (3 bit)
		lspci :
		01:00.0 Ethernet controller: Microchip Technology / SMSC LAN7431...
		Bus: 01, Device/Slot: 00, Function: 0
	*/
	pcie@0,0 {
		#address-cells = <0x03>;
		#size-cells = <0x02>;
		compatible ="pci16c3,abcd";
		reg = <0x00000000 0 0 0 0>;
		class-code = <0x060400>; /* bridge */
		status = "okay";

		lan7431: ethernet@1,0 {
			compatible ="pci1055,7431";
			reg = <0x01000000 0 0 0 0>;
			class-code = <0x020000>; /* network */
			rx-internal-delay-ps = <0>;
			tx-internal-delay-ps = <0>;
			phy-connection-type = "rgmii";
			status = "okay";
			fixed-link {
				speed = <1000>;
				full-duplex;
			};
		};
	};
};

/*
 * SD/MMC and eMMC controllers
 */
&usdhc1 {				   /* externed - WiFi module */
	keep-power-in-suspend;
	cap-power-off-card;
	non-removable;
	max-frequency = <25000000>;
	status = "okay";
	vmmc-supply = <&reg_wl1837_p1v8>;
	#address-cells = <1>;
	#size-cells = <0>;

	WL1837MOD: wlcore@2 {
		compatible = "ti,wl1837";
		enable-gpios = <&gpio1 6 GPIO_ACTIVE_HIGH>;	/* soDimm 180 */
		reg = <2>;
		interrupt-parent = <&gpio5>;
		interrupts = <18 IRQ_TYPE_LEVEL_HIGH>;		/* soDimm 172 */
		tcxo-clock-frequency = <26000000>;
	};
};
&usdhc2 {	status = "okay";	}; /* compatible */
/* &usdhc3 {	status = "okay";	}; => eMMC allways enabled */


/*
 * Ethernet controller
 */
/* &fec {	status = "okay";	}; => eth0 allways enabled */

/*
 * Audio (digital part)
 */
&sgtl5000 {	status = "disabled";	};
&module_sound {	status = "disabled";	};
&ssi1	{	status = "disabled";	};
&ssi2 	{	status = "okay";	}; /* for external codec */

&usbotg	{ /* OTG */
	status = "okay";
};

/*
 * PWMs
 */
/* Defaults. pwm3, pwm4 disabled*/
&pwm3 {
	status = "okay";
};
&pwm4 {
	status = "disabled";
};

&iomuxc {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_hog>, <&pinctrl_uart1gpio>;
};
